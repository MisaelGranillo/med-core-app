# Cloudflare Pages aplica las reglas por ruta de la petición, en orden; si dos
# reglas fijan la misma cabecera, los valores se concatenan — por eso /assets/*
# primero la quita (`! Cache-Control`) y luego pone la suya.
# Las respuestas 404 siempre salen con `no-store` (Pages lo fuerza), así que un
# chunk ausente nunca queda cacheado.

# HTML y demás: revalidar siempre. Cubre /, /index.html y las rutas SPA
# (/topic/:id…), que Pages sirve con index.html bajo la ruta pedida.
/*
  Cache-Control: no-cache

# Bundles de Vite con hash en el nombre: inmutables.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Descargas del taller (/taller/descargas): estáticos que cambian poco, caché de
# un día. Pages ya sirve los archivos existentes tal cual; los que falten caen
# en public/taller/descargas/404.html, nunca en index.html.
/taller/descargas/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Los .pdf ya salen como application/pdf (Pages lo infiere por la extensión) y se
# pueden abrir en el navegador. No se usa una regla «*.pdf» porque también se
# aplicaría al 404 de un archivo que no existe. El ZIP se nombra explícitamente.
/taller/descargas/Taller_Autoestudio_Todo.zip
  Content-Type: application/zip
  Content-Disposition: attachment
